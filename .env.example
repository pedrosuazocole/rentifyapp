# ─── Servidor ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Base de Datos ───────────────────────────────────────────────
# Railway: postgresql://user:pass@host.railway.app:port/railway
# Local:   postgresql://postgres:password@localhost:5432/rentify_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/rentify_db"

# ─── Autenticación JWT ───────────────────────────────────────────
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_muy_segura_de_al_menos_64_caracteres
JWT_EXPIRES_IN=7d

# ─── Twilio WhatsApp ─────────────────────────────────────────────
# Obtené tus credenciales en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── API de Tipo de Cambio ───────────────────────────────────────
# Cuenta gratuita en: https://www.exchangerate-api.com (1500 req/mes gratis)
EXCHANGE_RATE_API_KEY=tu_api_key_aqui

# ─── Configuración Regional ──────────────────────────────────────
DEFAULT_CURRENCY=HNL
DEFAULT_TIMEZONE=America/Tegucigalpa
