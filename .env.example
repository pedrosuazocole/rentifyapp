# ─── Servidor ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Base de Datos ───────────────────────────────────────────────
# Railway: postgresql://user:pass@host.railway.app:port/railway
# Local:   postgresql://postgres:password@localhost:5432/rentify_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/rentify_db"

# ─── Autenticación JWT ───────────────────────────────────────────
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_muy_segura_de_al_menos_64_caracteres
JWT_EXPIRES_IN=7d

# ─── Twilio WhatsApp ─────────────────────────────────────────────
# Obtené tus credenciales en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Tipo de Cambio ───────────────────────────────────────────────
# La tasa de VENTA se obtiene automáticamente todos los días a las 7am
# desde la página pública de Banpaís (https://www.corporacionbi.com/hn/banpais/),
# sin necesidad de API key. Esta variable ya NO se usa, se deja solo
# por compatibilidad si en el futuro se vuelve a una API externa.
EXCHANGE_RATE_API_KEY=

# ─── Configuración Regional ──────────────────────────────────────
DEFAULT_CURRENCY=HNL
DEFAULT_TIMEZONE=America/Tegucigalpa
